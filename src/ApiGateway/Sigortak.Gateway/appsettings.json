{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      }
    }
  },

  "Jwt": {
    "Secret": "VGhpcyBpcyBhIHN1cGVyIHNlY3VyZSBTaWdvcnRhayBKV1Qgc2VjcmV0IGtleSEgMjAyNg==",
    "Issuer": "sigortak-identity-api",
    "Audience": "sigortak-clients"
  },

  "ReverseProxy": {
    "Routes": {
      "identity-auth-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "identity-users-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        }
      },
      "vehicle-route": {
        "ClusterId": "vehicle-cluster",
        "Match": {
          "Path": "/api/v1/vehicles/{**catch-all}"
        }
      },
      "policy-route": {
        "ClusterId": "vehicle-cluster",
        "Match": {
          "Path": "/api/v1/policies/{**catch-all}"
        }
      },
      "identity-health-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/services/identity/health"
        },
        "Transforms": [
          { "PathSet": "/health" }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-api": {
            "Address": "http://localhost:5001/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "vehicle-cluster": {
        "Destinations": {
          "vehicle-api": {
            "Address": "http://localhost:5002/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      }
    }
  }
}
